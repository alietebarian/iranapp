<?xml version="1.0" encoding="utf-8"?>
<!-- A tile on the dark pages that should stand out from the grid (e.g. «کاربران پرو»):
     the usual tile with an accent-tinted border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="@color/home_tile" />
    <stroke
        android:width="1dp"
        android:color="@color/home_tile_stroke_accent" />
</shape>
