<?xml version="1.0" encoding="utf-8"?>
<!-- Colours of the app's landing page (the "دسته بندی ها" tab) and of the sub category dialog.
     Every icon uses the same plate and the same colour, so the grid reads as one formal set. -->
<resources>
    <!-- Dark landing page -->
    <color name="home_bg_top">#1C2233</color>
    <color name="home_bg_bottom">#121620</color>
    <color name="home_tile">#222A3B</color>
    <color name="home_tile_stroke">#2C3547</color>
    <color name="home_text">#EEF1F6</color>
    <color name="home_text_muted">#A9B2C3</color>
    <color name="home_accent">#FF5252</color>

    <!-- Category icons on the landing page -->
    <color name="home_icon">#E6EBF3</color>
    <color name="home_icon_plate">#283042</color>
    <color name="home_icon_plate_stroke">#3A4558</color>

    <!-- Sub category icons on the (white) sub category dialog -->
    <color name="sub_icon">#2B3440</color>
    <color name="sub_icon_plate">#F2F4F7</color>
    <color name="sub_icon_plate_stroke">#DFE3EA</color>
</resources>
