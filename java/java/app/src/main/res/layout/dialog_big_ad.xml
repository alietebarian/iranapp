<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/dialogVipAdImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/place_holder" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="2dp"
        app:cardBackgroundColor="#74ffffff">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.ideabonyan.iranapp.Components.MyTextView
                android:id="@+id/dialogVipAdTitle"
                android:layout_width="match_parent"
                android:text="شرکت خیلی خفن"
                android:gravity="center"
                android:textColor="#263238"
                android:shadowColor="#fff"
                android:shadowDx="0.0"
                android:shadowDy="0.0"
                android:shadowRadius="8.0"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"/>

            <LinearLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.ideabonyan.iranapp.Components.MyButton
                    android:id="@+id/dialogVipAdCallBTN"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_margin="3dp"
                    android:layout_weight="3"
                    android:background="@drawable/btn_green_transparent"
                    android:text="تماس"
                    android:textColor="#fff" />

                <com.ideabonyan.iranapp.Components.MyButton
                    android:id="@+id/dialogVipAdShowBTN"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_margin="3dp"
                    android:layout_weight="3"
                    android:background="@drawable/btn_blue_transparent"
                    android:text="مشاهده"
                    android:textColor="#fff" />

                <com.ideabonyan.iranapp.Components.MyButton
                    android:id="@+id/dialogVipAdDismissBTN"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_margin="3dp"
                    android:layout_weight="3"
                    android:background="@drawable/btn_red_transparent"
                    android:text="رد کردن"
                    android:textColor="#fff" />

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>