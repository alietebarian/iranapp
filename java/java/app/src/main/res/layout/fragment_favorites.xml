<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/favoritesFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    tools:context="com.ideabonyan.iranapp.Fragment.Fav.FavoritesFragment">

    <com.ideabonyan.iranapp.Components.MyTextView
        android:id="@+id/favoritesNotLoggedInWarn"
        android:visibility="gone"
        android:layout_margin="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="لطفا به قسمت منو رفته و وارد حساب خود شوید"/>

    <ProgressBar
        android:id="@+id/favoritesProgressBar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/colorPrimary" />

    <android.support.v7.widget.RecyclerView
        android:id="@+id/favoritesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/favoritesLoadMoreProgressBar"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="-6dp"
        android:visibility="gone"
        android:indeterminateTint="@color/colorPrimary"
        style="@style/Base.Widget.AppCompat.ProgressBar.Horizontal"
        android:indeterminate="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />



    <RelativeLayout
        android:visibility="gone"
        android:id="@+id/favoritesListEmptyIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">

        <ImageView
            android:src="@drawable/hearts"
            android:tint="@color/colorPrimary"
            android:alpha=".5"
            android:id="@+id/image"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_centerHorizontal="true" />

        <com.ideabonyan.iranapp.Components.MyTextView
            android:layout_width="wrap_content"
            android:layout_below="@id/image"
            android:layout_height="wrap_content"
            android:text="شما هنوز موردی به علاقه مندی های خود اضافه نکرده اید" />

    </RelativeLayout>

</RelativeLayout>
