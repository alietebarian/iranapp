<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr"
    android:orientation="vertical">

    <android.support.v7.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:background="#fff"
        app:cardElevation="5dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <android.support.v7.widget.CardView
                    android:id="@+id/relative"
                    app:cardCornerRadius="3dp"
                    android:layout_width="@dimen/_80sdp"
                    android:layout_height="@dimen/_80sdp">

                    <RelativeLayout
                        android:layout_width="@dimen/_80sdp"
                        android:layout_height="@dimen/_80sdp">

                        <ImageView
                            android:id="@+id/rvAdListImage"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="@dimen/_80sdp"
                            android:background="#c7c7c7" />

                    </RelativeLayout>
                </android.support.v7.widget.CardView>

            </LinearLayout>

            <LinearLayout
                android:gravity="right"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.ideabonyan.iranapp.Components.MyTextView
                    android:id="@+id/rvAdListTitle"
                    android:gravity="right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_margin="5dp"
                    android:layout_toRightOf="@id/relative"
                    android:maxLines="2"
                    android:text="آموزشگاه و سالن زیبایه کلبه آرزو"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_below="@+id/rvAdListTitle"
                    android:gravity="right|center_vertical"
                    android:paddingBottom="5dp"
                    android:paddingLeft="5dp"
                    android:paddingTop="5dp">

                    <com.ideabonyan.iranapp.Components.MyTextView
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:id="@+id/rvAdListAddress"
                        android:gravity="right"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="3dp"
                        android:layout_toRightOf="@id/relative"
                        android:maxLines="1"
                        android:text="جردن - خیابان سعیدی - پلاک 10 - واحد 3"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_location_on_black_24dp"
                        android:tint="@color/colorPrimary" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_below="@id/location"
                    android:gravity="right|center_vertical">

                    <RelativeLayout


                        android:id="@+id/rvAdListDiscountLayout"
                        android:layout_width="35dp"
                        android:layout_height="35dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:alpha=".9"
                            android:src="@drawable/decagram"
                            android:tint="@color/colorPrimary" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <com.ideabonyan.iranapp.Components.MyTextView
                                android:id="@+id/rvAdListDiscountText"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentLeft="true"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentTop="true"
                                android:layout_marginTop="0dp"
                                android:gravity="center|right"
                                android:text=" 50 %"
                                android:textColor="#fff"
                                android:textSize="10sp" />

                        </LinearLayout>

                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/lin_phone_number"
                        android:gravity="right|center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.ideabonyan.iranapp.Components.MyTextView
                            android:id="@+id/rvAdListNumber"
                            android:layout_width="wrap_content"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_below="@id/rvAdListAddress"
                            android:layout_margin="5dp"
                            android:gravity="right"
                            android:maxLines="1"
                            android:text=""
                            android:textSize="12sp" />

                        <ImageView
                            android:id="@+id/imageView"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_phone_black_24dp"
                            android:tint="@color/colorPrimary" />
                    </LinearLayout>





                </LinearLayout>

                <ImageView
                    android:id="@+id/rvAdListPendingIdentifier"
                    android:visibility="gone"
                    android:layout_below="@id/location"
                    android:layout_toRightOf="@id/relative"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="5dp"
                    android:tint="#FB8C00"
                    android:src="@drawable/pending"
                    android:layout_width="20dp"
                    android:layout_height="20dp" />
            </LinearLayout>
        </LinearLayout>




    </android.support.v7.widget.CardView>

</RelativeLayout>