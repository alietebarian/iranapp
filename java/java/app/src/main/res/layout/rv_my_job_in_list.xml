<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:background="#fff"
        app:cardElevation="5dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/lin_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/relative"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="@dimen/_80sdp"
                            app:cardCornerRadius="3dp">

                            <RelativeLayout
                                android:layout_width="@dimen/_80sdp"
                                android:layout_height="@dimen/_80sdp">

                                <ImageView
                                    android:id="@+id/rvAdListImage"
                                    android:layout_width="@dimen/_80sdp"
                                    android:layout_height="@dimen/_80sdp"
                                    android:background="#c7c7c7" />

                            </RelativeLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="right"
                        android:orientation="vertical">

                        <com.ideabonyan.iranapp.Components.MyTextView
                            android:id="@+id/rvAdListTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_margin="5dp"
                            android:layout_toRightOf="@id/relative"
                            android:gravity="right"
                            android:maxLines="2"
                            android:text="آموزشگاه و سالن زیبایه کلبه آرزو"
                            android:textColor="@color/colorPrimary"
                            android:textSize="14sp" />

                        <com.ideabonyan.iranapp.Components.MyTextView
                            android:visibility="invisible"
                            android:id="@+id/txt_cost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_margin="5dp"
                            android:layout_toRightOf="@id/relative"
                            android:gravity="right"
                            android:maxLines="2"
                            android:text="12.000.000"
                            android:textColor="#009688"
                            android:textSize="10sp" />

                        <LinearLayout
                            android:id="@+id/location"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentRight="true"
                            android:layout_below="@+id/rvAdListTitle"
                            android:gravity="right|center_vertical"
                            android:orientation="horizontal"
                            android:paddingBottom="5dp"
                            android:paddingLeft="5dp"
                            android:paddingTop="5dp">

                            <com.ideabonyan.iranapp.Components.MyTextView
                                android:id="@+id/rvAdListAddress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="3dp"
                                android:layout_toRightOf="@id/relative"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="right"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:text="جردن - خیابان سعیدی - پلاک 10 - واحد 3"
                                android:textSize="12sp" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_location_on_black_24dp"
                                android:tint="@color/colorPrimary" />

                        </LinearLayout>


                        <ImageView
                            android:id="@+id/rvAdListPendingIdentifier"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_below="@id/location"
                            android:layout_marginLeft="5dp"
                            android:layout_marginTop="5dp"
                            android:layout_toRightOf="@id/relative"
                            android:src="@drawable/pending"
                            android:tint="#FB8C00"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <com.ideabonyan.iranapp.Components.MyTextView
                    android:id="@+id/txt_statous"
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:background="#388E3C"
                    android:gravity="center"
                    android:text="وضعیت"
                    android:textColor="#fff" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/lin_edit"
                android:layout_width="match_parent"
                android:layout_height="fill_parent"
                android:background="#455A64"
                android:orientation="vertical"
                android:visibility="invisible">

                <LinearLayout
                    android:id="@+id/lin_go_back"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                    android:gravity="right|center_vertical"
                    android:orientation="horizontal"
                    tools:targetApi="lollipop">

                    <com.ideabonyan.iranapp.Components.MyTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:layout_weight="1"
                        android:text="بازگشت"
                        android:textColor="#fff" />

                    <LinearLayout
                        android:layout_width="30dp"

                        android:layout_height="30dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_replay_black_24dp"
                            android:tint="#fff" />
                    </LinearLayout>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#fff" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/lin_delete_product"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        tools:targetApi="lollipop">

                        <com.ideabonyan.iranapp.Components.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:text="حذف آگهی"
                            android:textColor="#fff" />

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:src="@drawable/ic_delete_forever_black_24dp"
                            android:tint="#fff" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#fff" />

                    <LinearLayout
                        android:id="@+id/lin_edit_product"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        tools:targetApi="lollipop">

                        <com.ideabonyan.iranapp.Components.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:text="ویرایش آگهی"
                            android:textColor="#fff" />

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:src="@drawable/ic_import_contacts_black_24dp"
                            android:tint="#fff" />

                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>

        </FrameLayout>


    </androidx.cardview.widget.CardView>

</RelativeLayout>