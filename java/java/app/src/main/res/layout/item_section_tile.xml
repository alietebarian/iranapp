<?xml version="1.0" encoding="utf-8"?>
<!-- One tile of the املاک / وسایل نقلیه / استخدام pages, drawn like the landing page's category
     tiles (rv_home_categories2). Included with the id the fragment clicks on; icon, title and the
     optional subtitle are set by SectionTiles.bind(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_home_tile"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/ripple_home_tile"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="4dp"
    android:paddingTop="14dp"
    android:paddingRight="4dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="@dimen/_46sdp"
        android:layout_height="@dimen/_46sdp"
        android:background="@drawable/bg_icon_plate_dark">

        <com.ideabonyan.iranapp.Components.GradientIconView
            android:id="@+id/sectionTileIcon"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_cat_estate" />

    </FrameLayout>

    <com.ideabonyan.iranapp.Components.MyTextView
        android:id="@+id/sectionTileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:textColor="@color/home_text"
        android:textSize="11sp"
        tools:text="فروش مسکونی" />

    <com.ideabonyan.iranapp.Components.MyTextView
        android:id="@+id/sectionTileSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:textColor="@color/home_text_muted"
        android:textSize="9sp"
        android:visibility="gone"
        tools:text="آپارتمان، خانه، زمین"
        tools:visibility="visible" />

</LinearLayout>
