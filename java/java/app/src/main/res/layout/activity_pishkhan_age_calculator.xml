<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/ageCalculator"
    android:layoutDirection="ltr"
    tools:context="com.ideabonyan.iranapp.Activity.PishkhanWebviewActivity">

    <android.support.design.widget.AppBarLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/toolbar_in_newad"/>
        <View
            android:background="@color/colorPrimary"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </android.support.design.widget.AppBarLayout>

    <ProgressBar
        android:id="@+id/ageCalculatorProgressBar"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/colorPrimary"
        android:layout_width="40dp"
        android:layout_height="40dp" />

    <WebView
        android:visibility="invisible"
        android:id="@+id/ageCalculatorWebView"
        android:layout_below="@id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</RelativeLayout>
