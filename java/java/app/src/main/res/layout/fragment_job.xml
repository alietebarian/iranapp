<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.ideabonyan.iranapp.Fragment.home.Car">

    <LinearLayout
        android:layout_marginTop="15dp"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/lin_employe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.joooonho.SelectableRoundedImageView xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:layout_width="@dimen/_63sdp"
                    android:layout_height="@dimen/_63sdp"
                    android:scaleType="fitXY"
                    android:src="#f44336"
                    app:sriv_left_bottom_corner_radius="4dp"
                    app:sriv_left_top_corner_radius="4dp"
                    app:sriv_right_bottom_corner_radius="4dp"
                    app:sriv_right_top_corner_radius="4dp" />

                <ImageView
                    android:tint="#fff"
                    android:src="@drawable/employer"
                    android:elevation="1dp"
                    android:layout_gravity="center"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    />
                <!--</RelativeLayout>-->
                <!--</androidx.cardview.widget.CardView>-->
            </FrameLayout>
            <!--</RelativeLayout>-->
            <!--</androidx.cardview.widget.CardView>-->

            <com.ideabonyan.iranapp.Components.MyTextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:elevation="10dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="استخدام"
                android:textColor="#37474F"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lin_worker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.joooonho.SelectableRoundedImageView xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:layout_width="@dimen/_63sdp"
                    android:layout_height="@dimen/_63sdp"
                    android:scaleType="fitXY"
                    android:src="#E91E63"
                    app:sriv_left_bottom_corner_radius="4dp"
                    app:sriv_left_top_corner_radius="4dp"
                    app:sriv_right_bottom_corner_radius="4dp"
                    app:sriv_right_top_corner_radius="4dp" />

                <ImageView
                    android:tint="#fff"
                    android:src="@drawable/worker"
                    android:elevation="1dp"
                    android:layout_gravity="center"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    />
                <!--</RelativeLayout>-->
                <!--</androidx.cardview.widget.CardView>-->
            </FrameLayout>
            <!--</RelativeLayout>-->
            <!--</androidx.cardview.widget.CardView>-->

            <com.ideabonyan.iranapp.Components.MyTextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:elevation="10dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="آماده به کار"
                android:textColor="#37474F"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_marginTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/lin_both"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">

            <FrameLayout
                android:layout_marginTop="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.joooonho.SelectableRoundedImageView
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:layout_width="match_parent"
                    android:layout_marginRight="@dimen/_30sdp"
                    android:layout_marginLeft="@dimen/_30sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:scaleType="fitXY"
                    android:src="#00BCD4"
                    app:sriv_left_bottom_corner_radius="4dp"
                    app:sriv_left_top_corner_radius="4dp"
                    app:sriv_right_bottom_corner_radius="4dp"
                    app:sriv_right_top_corner_radius="4dp" />

                <LinearLayout
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:tint="#fff"
                        android:src="@drawable/employer"
                        android:elevation="1dp"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        />
                    <ImageView
                        android:layout_marginRight="@dimen/_50sdp"
                        android:layout_marginLeft="@dimen/_50sdp"
                        android:tint="#fff"
                        android:src="@drawable/ic_add_black_24dp"
                        android:elevation="1dp"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        />
                    <ImageView
                        android:tint="#fff"
                        android:src="@drawable/worker"
                        android:elevation="1dp"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        />

                </LinearLayout>

                <!--</RelativeLayout>-->
                <!--</androidx.cardview.widget.CardView>-->
            </FrameLayout>
            <!--</RelativeLayout>-->
            <!--</androidx.cardview.widget.CardView>-->

            <com.ideabonyan.iranapp.Components.MyTextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:elevation="10dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="هر دو"
                android:textColor="#37474F"
                android:textSize="12sp" />

        </LinearLayout>


    </LinearLayout>



</LinearLayout>
