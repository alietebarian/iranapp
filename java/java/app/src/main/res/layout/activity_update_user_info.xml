<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:layoutDirection="ltr"

    android:focusableInTouchMode="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/updateInfoContent"
    tools:context="com.ideabonyan.iranapp.Activity.SignUpActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.appbar.AppBarLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_263sdp"
                    android:background="@drawable/gradient"
                    android:elevation="5dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_weight="1"
                    android:elevation="6dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">


                    <com.ideabonyan.iranapp.Components.MyTextView
                        android:id="@+id/name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="ویرایش اطلاعات"
                        android:textColor="#fff"
                        android:textSize="20sp" />


                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:layout_marginTop="20dp"
                        app:cardBackgroundColor="#ffffff"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="4dp"
                        app:contentPadding="5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.ideabonyan.iranapp.Components.MyTextView
                                android:id="@+id/updateInfoNameWarningTXT"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="-15dp"
                                android:gravity="left"
                                android:text="لطفا نام خود را وارد کنید"
                                android:textColor="#df0404"
                                android:textSize="10sp"
                                android:visibility="gone" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.ideabonyan.iranapp.Components.MyEdittextView
                                    android:id="@+id/updateInfoNameEDT"
                                    android:layout_width="match_parent"
                                    android:layout_height="50dp"
                                    android:layout_marginBottom="10dp"
                                    android:background="@drawable/edittext_background"
                                    android:gravity="center_vertical|right"
                                    android:hint="نام"
                                    android:paddingRight="8dp"
                                    android:textSize="15sp" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.ideabonyan.iranapp.Components.MyTextView
                                android:id="@+id/updateInfoFamilyWarning"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="-15dp"
                                android:gravity="left"
                                android:text="لطفا نام خانوادگی خود را وارد کنید"
                                android:textColor="#df0404"
                                android:textSize="10sp"
                                android:visibility="gone" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.ideabonyan.iranapp.Components.MyEdittextView
                                    android:id="@+id/updateInfoFamilyEDT"
                                    android:layout_width="match_parent"
                                    android:layout_height="50dp"
                                    android:layout_marginBottom="10dp"
                                    android:background="@drawable/edittext_background"
                                    android:gravity="center_vertical|right"
                                    android:hint="نام خانوادگی"
                                    android:paddingRight="8dp"
                                    android:textSize="15sp" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.ideabonyan.iranapp.Components.MyTextView
                                android:id="@+id/updateInfoNumberWarnTXT"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="-15dp"
                                android:gravity="left"
                                android:text="تغییر دادن شماره همراه امکان پذیر نیست"
                                android:textColor="#df0404"
                                android:textSize="10sp"
                                android:visibility="gone" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.ideabonyan.iranapp.Components.CustomEditText
                                    android:drawableLeft="@drawable/ic_lock_black_24dp"
                                    android:drawableTint="#f44336"
                                    android:id="@+id/updateInfoNumberEDT"
                                    android:layout_width="match_parent"
                                    android:layout_height="50dp"
                                    android:layout_marginBottom="10dp"
                                    android:background="@drawable/edittext_background"
                                    android:gravity="center_vertical|right"
                                    android:hint="شماره همراه"
                                    android:inputType="number"
                                    android:paddingRight="8dp"
                                    android:textSize="15sp"

                                    android:focusable="false"
                                    android:clickable="true"
                                    android:textColor="#757575"/>
                            </com.google.android.material.textfield.TextInputLayout>


                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_marginTop="10dp"
                                android:layout_height="45dp">

                                <com.ideabonyan.iranapp.Components.MyButton
                                    android:id="@+id/updateInfoupdateInfoBTN"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/login_login_btn"
                                    android:gravity="center"
                                    android:text="اعمال تغییرات"
                                    android:textColor="#fff"
                                    android:textSize="16sp" />

                                <ProgressBar
                                    android:id="@+id/updateInfoProgressbar"
                                    android:layout_centerInParent="true"
                                    android:indeterminateTint="#fff"
                                    android:elevation="10dp"
                                    android:visibility="gone"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp" />

                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="5dp"
                                android:layout_marginTop="5dp"
                                android:clickable="true"
                                android:foreground="?android:attr/selectableItemBackground"
                                android:gravity="right|center_vertical"
                                android:orientation="horizontal"
                                android:paddingBottom="5dp"
                                android:paddingTop="5dp">

                                <com.ideabonyan.iranapp.Components.MyTextView
                                    android:visibility="gone"
                                    android:id="@+id/rulesTXT"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="10dp"
                                    android:clickable="true"
                                    android:text="قوانین و مقررات"
                                    android:textColor="#009688" />
                            </LinearLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/updateInfoChangePassActivityBTN"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/login_sign_up_btn"
        android:clickable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="horizontal">

        <com.ideabonyan.iranapp.Components.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تغییر رمز ورود"
            android:textColor="#fff"
            android:textSize="16sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="8dp"
            android:src="@drawable/ic_vpn_key_white_24dp" />

    </LinearLayout>

</LinearLayout>
