<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/kasbokarNewest"
    android:layoutDirection="ltr"
    tools:context="com.ideabonyan.iranapp.Fragment.KasbokarTabs.Newest">

    <ProgressBar
        android:id="@+id/kasbokarNewestProgressBar"
        android:indeterminateTint="@color/colorPrimary"
        android:layout_centerInParent="true"
        android:layout_width="40dp"
        android:layout_height="40dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/kasbokarNewestRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ProgressBar
        android:id="@+id/kasbokarNewestLoadMoreProgressBar"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="-6dp"
        android:visibility="gone"
        android:indeterminateTint="@color/colorPrimary"
        style="@style/Base.Widget.AppCompat.ProgressBar.Horizontal"
        android:indeterminate="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />


    <RelativeLayout
        android:id="@+id/kasbokarNewestListEmptyDialog"
        android:gravity="center"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="30dp">

        <LinearLayout
            android:id="@+id/text1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.ideabonyan.iranapp.Components.MyTextView
                android:text="متاسفانه هنوز در شهر شما آگهی ثبت نشده است"
                android:textColor="#616161"
                android:gravity="center"
                android:textSize="15sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/text2"
            android:layout_below="@id/text1"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.ideabonyan.iranapp.Components.MyTextView
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="شما میتوانید با رفتن به تب «منو» و با زدن بر روی «درج آگهی» اولین آگهی شهرتان را ثبت کنید."
                android:layout_marginRight="20dp"/>
            <ImageView
                android:src="@drawable/ic_fiber_manual_record_black_24dp"
                android:tint="@color/colorPrimary"
                android:alpha=".5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:layout_below="@id/text2"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.ideabonyan.iranapp.Components.MyTextView
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="برای دیدن آگهی های شهرهای اطراف به تب «منو» بروید، و با زدن بر روی «تعیین موقعیت» شهر های اطراف خود را انتخاب کنید."
                android:layout_marginRight="20dp"/>
            <ImageView
                android:src="@drawable/ic_fiber_manual_record_black_24dp"
                android:tint="@color/colorPrimary"
                android:alpha=".5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </RelativeLayout>


</RelativeLayout>
