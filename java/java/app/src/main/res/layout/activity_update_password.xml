<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:layoutDirection="ltr"

    android:focusableInTouchMode="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/updatePassContent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.appbar.AppBarLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_246sdp"
                    android:background="@drawable/gradient"
                    android:elevation="5dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_weight="1"
                    android:elevation="6dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">


                    <com.ideabonyan.iranapp.Components.MyTextView
                        android:id="@+id/name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="تغییر رمز ورود"
                        android:textColor="#fff"
                        android:textSize="20sp" />


                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:layout_marginTop="20dp"
                        app:cardBackgroundColor="#ffffff"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="4dp"
                        app:contentPadding="5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">



                            <com.ideabonyan.iranapp.Components.MyTextView
                                android:id="@+id/updatePassCurrentPassWarnTXT"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="-15dp"
                                android:gravity="left"
                                android:text="لطفا کلمه عبور فعلی خود را وارد کنید"
                                android:textColor="#df0404"
                                android:textSize="10sp"
                                android:visibility="gone" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/updateCurrentPassTIL"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.ideabonyan.iranapp.Components.CustomEditText
                                    android:id="@+id/updatePassCurrentPassEDT"
                                    android:layout_width="match_parent"
                                    android:layout_height="50dp"
                                    android:background="@drawable/edittext_background"
                                    android:drawableLeft="@drawable/ic_visibility_black_24dp"
                                    android:drawableTint="#f44336"
                                    android:ems="10"
                                    android:gravity="center_vertical|right"
                                    android:hint="کلمه عبور فعلی"
                                    android:inputType="textPassword"
                                    android:paddingLeft="5dp"
                                    android:paddingRight="8dp"
                                    android:textSize="15sp" />

                        </com.google.android.material.textfield.TextInputLayout>


                            <com.ideabonyan.iranapp.Components.MyTextView
                                android:id="@+id/updatePassPassWarnTXT"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="-15dp"
                                android:gravity="left"
                                android:text="لطفا کلمه عبور جدید را وارد کنید"
                                android:textColor="#df0404"
                                android:textSize="10sp"
                                android:visibility="gone" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/updatePassTIL"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.ideabonyan.iranapp.Components.CustomEditText
                                    android:id="@+id/updatePassPassEDT"
                                    android:layout_width="match_parent"
                                    android:layout_height="50dp"
                                    android:background="@drawable/edittext_background"
                                    android:drawableLeft="@drawable/ic_visibility_black_24dp"
                                    android:drawableTint="#f44336"
                                    android:ems="10"
                                    android:gravity="center_vertical|right"
                                    android:hint="کلمه عبور جدید"
                                    android:inputType="textPassword"
                                    android:paddingLeft="5dp"
                                    android:paddingRight="8dp"
                                    android:textSize="15sp" />

                            </com.google.android.material.textfield.TextInputLayout>


                            <com.ideabonyan.iranapp.Components.MyTextView
                                android:id="@+id/updatePassPassAgainWarnTXT"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="-15dp"
                                android:gravity="left"
                                android:text="لطفا کلمه عبور جدید را دوباره وارد کنید"
                                android:textColor="#df0404"
                                android:textSize="10sp"
                                android:visibility="gone" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/updatePassAgainTIL"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.ideabonyan.iranapp.Components.CustomEditText
                                    android:id="@+id/updatePassPassAgainEDT"
                                    android:layout_width="match_parent"
                                    android:layout_height="50dp"
                                    android:background="@drawable/edittext_background"
                                    android:drawableLeft="@drawable/ic_visibility_black_24dp"
                                    android:drawableTint="#f44336"
                                    android:ems="10"
                                    android:gravity="center_vertical|right"
                                    android:hint="تکرار کلمه عبور جدید"
                                    android:inputType="textPassword"
                                    android:paddingLeft="5dp"
                                    android:paddingRight="8dp"
                                    android:textSize="15sp" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_marginTop="20dp"
                                android:layout_height="45dp">

                                <com.ideabonyan.iranapp.Components.MyButton
                                    android:id="@+id/updatePassupdatePassBTN"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/login_login_btn"
                                    android:gravity="center"
                                    android:text="اعمال تغییرات"
                                    android:textColor="#fff"
                                    android:textSize="16sp" />

                                <ProgressBar
                                    android:id="@+id/updatePassProgressbar"
                                    android:layout_centerInParent="true"
                                    android:indeterminateTint="#fff"
                                    android:elevation="10dp"
                                    android:visibility="gone"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp" />

                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="5dp"
                                android:layout_marginTop="5dp"
                                 android:gravity="right|center_vertical"
                                android:orientation="horizontal"
                                android:paddingBottom="5dp"
                                android:paddingTop="5dp">

                                <com.ideabonyan.iranapp.Components.MyTextView
                                    android:visibility="gone"
                                    android:id="@+id/rulesTXT"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="10dp"
                                    android:clickable="true"
                                    android:text="قوانین و مقررات"
                                    android:textColor="#009688" />
                            </LinearLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
