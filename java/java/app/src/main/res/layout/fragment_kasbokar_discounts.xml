<?xml version="1.0" encoding="utf-8"?>
<!-- Landing page of the app: the "دسته بندی ها" tab of KasbokarFragment.
     IDs are bound by com.ideabonyan.iranapp.Fragment.KasbokarTabs.WithDiscounts. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/kasbokarDiscounts"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cat_bg"
    android:layoutDirection="ltr"
    tools:context="com.ideabonyan.iranapp.Fragment.KasbokarTabs.WithDiscounts">

    <ProgressBar
        android:id="@+id/kasbokarDiscountsProgressBar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/colorPrimary" />

    <RelativeLayout
        android:id="@+id/kasbokarDiscountsRvArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/kasbokarDiscountsRV"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingLeft="7dp"
            android:paddingTop="10dp"
            android:paddingRight="7dp"
            android:paddingBottom="10dp"
            android:scrollbars="none" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/kasbokarDiscountsListEmptyDialog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginLeft="28dp"
            android:layout_marginRight="28dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/emptyIcon"
                android:layout_width="@dimen/_64sdp"
                android:layout_height="@dimen/_64sdp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_category_empty_circle"
                android:contentDescription="@null"
                android:padding="@dimen/_16sdp"
                android:src="@drawable/ic_cat_default"
                android:tint="@color/colorPrimary" />

            <com.ideabonyan.iranapp.Components.MyTextView
                android:id="@+id/text1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="متاسفانه هنوز در شهر شما آگهی ثبت نشده است"
                android:textColor="#3E4A56"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/text2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical">

                <com.ideabonyan.iranapp.Components.MyTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="14dp"
                    android:layout_weight="1"
                    android:text="شما میتوانید با رفتن به تب «منو» و با زدن بر روی «درج آگهی» اولین آگهی شهرتان را ثبت کنید."
                    android:textColor="#5B6774"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fiber_manual_record_black_24dp"
                    android:tint="@color/colorPrimary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">

                <com.ideabonyan.iranapp.Components.MyTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="14dp"
                    android:layout_weight="1"
                    android:text="برای دیدن آگهی های شهرهای اطراف به تب «منو» بروید، و با زدن بر روی «تعیین موقعیت» شهر های اطراف خود را انتخاب کنید."
                    android:textColor="#5B6774"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fiber_manual_record_black_24dp"
                    android:tint="@color/colorPrimary" />
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
