<?xml version="1.0" encoding="utf-8"?>
<!-- Landing page of the app: the "دسته بندی ها" tab of KasbokarFragment.
     IDs are bound by com.ideabonyan.iranapp.Fragment.KasbokarTabs.WithDiscounts. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/kasbokarDiscounts"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_dark"
    android:layoutDirection="ltr"
    tools:context="com.ideabonyan.iranapp.Fragment.KasbokarTabs.WithDiscounts">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- App install statistics; stays hidden until /app-stats/installs answers. -->
        <LinearLayout
            android:id="@+id/installStatsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:background="@drawable/bg_home_tile"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="right|center_vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">

                <com.ideabonyan.iranapp.Components.MyTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="آمار نصب ایران آپ"
                    android:textColor="@color/home_text"
                    android:textSize="12sp" />

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_icon_plate_dark">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_phone_android_black_24dp"
                        android:tint="@color/home_accent" />
                </FrameLayout>
            </LinearLayout>

            <!-- Reads right to left: total, last 30 days, today. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.ideabonyan.iranapp.Components.MyTextView
                        android:id="@+id/installStatsToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/home_text"
                        android:textSize="16sp" />

                    <com.ideabonyan.iranapp.Components.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="امروز"
                        android:textColor="@color/home_text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:background="@color/home_tile_stroke" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.ideabonyan.iranapp.Components.MyTextView
                        android:id="@+id/installStatsMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/home_text"
                        android:textSize="16sp" />

                    <com.ideabonyan.iranapp.Components.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="۳۰ روز اخیر"
                        android:textColor="@color/home_text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:background="@color/home_tile_stroke" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.ideabonyan.iranapp.Components.MyTextView
                        android:id="@+id/installStatsTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/home_accent"
                        android:textSize="16sp" />

                    <com.ideabonyan.iranapp.Components.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="کل نصب‌ها"
                        android:textColor="@color/home_text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ProgressBar
                android:id="@+id/kasbokarDiscountsProgressBar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/home_accent" />

            <!-- The grid always ends with the «درباره ما» tile, even when the city has no ads;
                 the "no ads yet" message then shows below the grid instead of replacing it. -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/kasbokarDiscountsRvArea"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/kasbokarDiscountsRV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingLeft="7dp"
                        android:paddingTop="10dp"
                        android:paddingRight="7dp"
                        android:paddingBottom="10dp"
                        android:scrollbars="none" />

                    <LinearLayout
                        android:id="@+id/kasbokarDiscountsListEmptyDialog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="28dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginRight="28dp"
                        android:layout_marginBottom="24dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/emptyIcon"
                            android:layout_width="@dimen/_64sdp"
                            android:layout_height="@dimen/_64sdp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/bg_category_empty_circle"
                            android:contentDescription="@null"
                            android:padding="@dimen/_16sdp"
                            android:src="@drawable/ic_cat_default"
                            android:tint="@color/home_accent" />

                        <com.ideabonyan.iranapp.Components.MyTextView
                            android:id="@+id/text1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="center"
                            android:text="متاسفانه هنوز در شهر شما آگهی ثبت نشده است"
                            android:textColor="@color/home_text"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:id="@+id/text2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:gravity="center_vertical">

                            <com.ideabonyan.iranapp.Components.MyTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="14dp"
                                android:layout_weight="1"
                                android:text="شما میتوانید با رفتن به تب «منو» و با زدن بر روی «درج آگهی» اولین آگهی شهرتان را ثبت کنید."
                                android:textColor="@color/home_text_muted"
                                android:textSize="12sp" />

                            <ImageView
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_fiber_manual_record_black_24dp"
                                android:tint="@color/home_accent" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical">

                            <com.ideabonyan.iranapp.Components.MyTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="14dp"
                                android:layout_weight="1"
                                android:text="برای دیدن آگهی های شهرهای اطراف به تب «منو» بروید، و با زدن بر روی «تعیین موقعیت» شهر های اطراف خود را انتخاب کنید."
                                android:textColor="@color/home_text_muted"
                                android:textSize="12sp" />

                            <ImageView
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_fiber_manual_record_black_24dp"
                                android:tint="@color/home_accent" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
