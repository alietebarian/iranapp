<?xml version="1.0" encoding="utf-8"?>
<!-- One category tile on the landing page ("دسته بندی ها").
     IDs homeCategoriesImage / homeCategoriesName are bound by HomeCategoriesAdapter. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="1.5dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingTop="12dp"
        android:paddingRight="4dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/homeCategoriesIconPlate"
            android:layout_width="@dimen/_46sdp"
            android:layout_height="@dimen/_46sdp"
            android:background="@drawable/bg_category_icon">

            <ImageView
                android:id="@+id/homeCategoriesImage"
                android:layout_width="@dimen/_26sdp"
                android:layout_height="@dimen/_26sdp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

        </FrameLayout>

        <com.ideabonyan.iranapp.Components.MyTextView
            android:id="@+id/homeCategoriesName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center_horizontal|top"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:minLines="2"
            android:text="دسته 1"
            android:textColor="@color/cat_title"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
