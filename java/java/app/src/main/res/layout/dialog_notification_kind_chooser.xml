<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="ltr"
    app:cardBackgroundColor="@color/colorPrimary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:background="#fff">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="15dp"
            android:orientation="vertical">

            <com.ideabonyan.iranapp.Components.MyCheckbox
                android:id="@+id/dialogNotifAds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/colorPrimary"
                android:text="آگهی ها" />

            <com.ideabonyan.iranapp.Components.MyCheckbox
                android:id="@+id/dialogNotifNews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/colorPrimary"
                android:text="اخبار" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:layout_marginTop="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ProgressBar
                        android:visibility="gone"
                        android:indeterminateTint="@color/hotText"
                        android:id="@+id/dialogNotifProgressBar"
                        android:layout_centerInParent="true"
                        android:layout_width="30dp"
                        android:layout_height="30dp" />


                    <com.ideabonyan.iranapp.Components.MyButton
                        android:id="@+id/dialogNotifSaveBTN"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#0000"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:text="ذخیره"
                        android:textColor="#00796B" />
                </RelativeLayout>

                <com.ideabonyan.iranapp.Components.MyButton
                    android:id="@+id/dialogNotifCancelBTN"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="#0000"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:text="انصراف"
                    android:textColor="#00796B" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</android.support.v7.widget.CardView>