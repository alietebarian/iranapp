<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#eeeeee"
    android:gravity="right"
    android:orientation="vertical"
    tools:context="com.ideabonyan.iranapp.Activity.Show_Home_List">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="fill_parent"
        android:layout_weight="1"
        android:gravity="right"
        android:orientation="vertical">


        <ProgressBar
            android:id="@+id/adListProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:indeterminateTint="@color/colorPrimary" />

        <android.support.v7.widget.RecyclerView
            android:visibility="gone"
            android:id="@+id/rv_add_Feed"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.ideabonyan.iranapp.Components.MyTextView
            android:id="@+id/txt_no_val"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="متاسفانه هیچ داده ای یافت نشد"
            android:textColor="#444"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/lin_no_row"
            android:layout_width="match_parent"
            android:layout_height="fill_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/aparteman"
                android:tint="@color/colorPrimary" />

            <com.ideabonyan.iranapp.Components.MyTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="متاسفانه هیچ داده ای یافت نشد" />
        </LinearLayout>


    </LinearLayout>

    <ProgressBar
        android:id="@+id/adListLoadMoreProgressBar"
        style="@style/Base.Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="-6dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/colorPrimary"
        android:visibility="gone" />


</LinearLayout>
