<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:layoutDirection="ltr">


    ///////////////////////////

    <!--<androidx.core.widget.NestedScrollView-->
    <!--android:id="@+id/dashboardNestedScroll"-->
    <!--android:layout_width="match_parent"-->
    <!--android:layout_height="match_parent"-->
    <!--app:layout_behavior="@string/appbar_scrolling_view_behavior">-->


    <!--</androidx.core.widget.NestedScrollView>-->


    <!--<com.google.android.material.appbar.AppBarLayout-->
    <!--android:layout_gravity="bottom"-->
    <!--android:layout_width="match_parent"-->
    <!--android:layout_height="25dp"-->
    <!--android:elevation="5dp">-->


    <!--</com.google.android.material.appbar.AppBarLayout>-->
    ////////////////////////////


    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:descendantFocusability="blocksDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar">
        /////////////////////////////////

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll|enterAlways"
            app:tabMode="scrollable">

            <RelativeLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_collapseMode="parallax">
                <!--android:background="#991010"-->

                <RelativeLayout
                    android:id="@+id/imageLayout"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="@dimen/_19sdp"
                    android:layout_marginTop="20dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="#ffffff"
                        app:civ_border_color="#e69090"
                        app:civ_border_width="2dp" />

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="10dp"
                        android:src="@drawable/account"
                        android:tint="@color/colorPrimary" />
                </RelativeLayout>

                <com.ideabonyan.iranapp.Components.MyTextView
                    android:id="@+id/dashboardName"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_toLeftOf="@id/imageLayout"
                    android:gravity="right|center_vertical"
                    android:text="سهیل محمد حسینی"
                    android:textColor="#fff" />


                <com.ideabonyan.iranapp.Components.MyTextView
                    android:id="@+id/dashboardNumber"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_below="@id/dashboardName"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_toLeftOf="@id/imageLayout"
                    android:gravity="right|center_vertical"
                    android:text="09176628061"
                    android:textColor="#fff" />


                <com.ideabonyan.iranapp.Components.MyTextView
                    android:id="@+id/dashboardLocation"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_below="@id/dashboardNumber"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_toLeftOf="@id/imageLayout"
                    android:gravity="right|center_vertical"
                    android:text="اصفهان - اصفهان"
                    android:textColor="#fff" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_below="@id/dashboardLocation"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="17dp"
                    android:layout_marginTop="10dp"
                    android:layout_toLeftOf="@id/imageLayout"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="1.5dp"
                        android:layout_marginRight="5dp"
                        android:layout_marginLeft="1.5dp"
                        android:layout_marginBottom="1.5dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="3dp"
                        app:cardElevation="3dp">
                        <LinearLayout
                            android:id="@+id/lin_exit"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:gravity="center">
                            <com.ideabonyan.iranapp.Components.MyTextView
                                android:textColor="#000"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="خروج"/>
                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="1.5dp"
                        android:layout_weight="1.5"
                        app:cardCornerRadius="3dp"
                        app:cardElevation="3dp">
                        <LinearLayout
                            android:id="@+id/lin_edit"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:gravity="center">
                            <com.ideabonyan.iranapp.Components.MyTextView
                                android:textColor="#000"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ویرایش حساب"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/dashboardOptionsBTN"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="15dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_more_vert_black_24dp"
                    android:tint="#fff"
                    android:visibility="gone" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@id/imageLayout"
                    android:layout_marginTop="20dp"
                    android:background="#ff8484"
                    android:visibility="gone" />


            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    app:cardCornerRadius="3dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:id="@+id/dashboardAddAd"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="#fff"
                        android:clickable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:gravity="center">

                        <com.ideabonyan.iranapp.Components.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="آگهی جدید"
                            android:textColor="#444" />

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:src="@drawable/ic_add_black_24dp"
                            android:tint="#444" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>


        </LinearLayout>

        <com.google.android.material.tabs.TabLayout

            android:id="@+id/tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:tabGravity="center"
            app:tabMode="scrollable" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager.widget.ViewPager

        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>