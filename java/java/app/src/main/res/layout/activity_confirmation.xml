<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/confirmationParent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="ltr"

    tools:context="com.ideabonyan.iranapp.Activity.ConfirmationActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_325sdp"
                android:background="@drawable/gradient"
                android:elevation="5dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_weight="1"
                android:elevation="6dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_marginBottom="@dimen/_15sdp"
                    android:layout_marginTop="@dimen/_20sdp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:layout_width="130dp"
                        android:layout_height="130dp"

                        android:src="@color/colorPrimary"
                        app:civ_border_color="#fff"
                        app:civ_border_width="2dp" />

                    <ImageView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:paddingLeft="10dp"
                        android:src="@drawable/user1"
                        android:tint="#fff" />

                </RelativeLayout>

                <com.ideabonyan.iranapp.Components.MyTextView
                    android:id="@+id/mytextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="تایید شماره"
                    android:textColor="#fff"
                    android:textSize="20sp" />


                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="#ffffff"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="4dp"
                    app:contentPadding="5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.ideabonyan.iranapp.Components.MyTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_11sdp"
                            android:gravity="center"
                            android:text="لطفا کد فرستاده شده به شماره خود را در کادر زیر وارد کنید"
                            android:textColor="#333333" />

                        <com.ideabonyan.iranapp.Components.MyTextView
                            android:id="@+id/confirmationFillWarn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="-23dp"
                            android:gravity="left"
                            android:text="لطفا شماره همراه خود را وارد کنید"
                            android:textColor="#df0404"
                            android:textSize="10sp"
                            android:visibility="gone" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"

                            android:layout_marginRight="5dp"
                            android:layout_marginTop="5dp"
                            android:textColorHint="#9e9e9e">

                            <com.ideabonyan.iranapp.Components.MyEdittextView
                                android:id="@+id/confirmationCodeEDT"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_marginBottom="10dp"
                                android:background="@drawable/edittext_background"
                                android:gravity="center_vertical|right"
                                android:hint="کد فعال سازی"
                                android:inputType="number"
                                android:paddingRight="8dp"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>


                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="20dp">

                            <com.ideabonyan.iranapp.Components.MyButton
                                android:id="@+id/confirmationOkBTN"
                                android:layout_width="match_parent"
                                android:layout_height="45dp"
                                android:background="@drawable/login_login_btn"
                                android:gravity="center"
                                android:text="تایید"
                                android:textColor="#fff"
                                android:textSize="16sp" />


                            <ProgressBar
                                android:id="@+id/confirmationProgressbar"
                                android:layout_centerInParent="true"
                                android:indeterminateTint="#fff"
                                android:elevation="10dp"
                                android:visibility="gone"
                                android:layout_width="30dp"
                                android:layout_height="30dp" />

                        </RelativeLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:layout_marginTop="5dp"
                            android:clickable="true"
                            android:foreground="?android:attr/selectableItemBackground"
                            android:gravity="right|center_vertical"
                            android:orientation="horizontal"
                            android:paddingBottom="5dp"
                            android:paddingTop="5dp">

                            <com.ideabonyan.iranapp.Components.MyTextView
                                android:id="@+id/confirmationChangeNumber"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="3dp"
                                android:layout_weight="6"
                                android:clickable="true"
                                android:text="تغییر شماره"
                                android:textColor="#009688" />


                        </LinearLayout>


                    </LinearLayout>
                </androidx.cardview.widget.CardView>


            </LinearLayout>


        </RelativeLayout>


    </LinearLayout>

    <LinearLayout
        android:id="@+id/resendConfirmationBTN"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/confirmation_disabled_button"
        android:clickable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="horizontal">

        <com.ideabonyan.iranapp.Components.MyTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="3dp"
            android:layout_weight="9"
            android:gravity="center"
            android:text="پیامک دریافت نکردید؟"
            android:textColor="#ffffff" />

        <com.ideabonyan.iranapp.Components.MyTextView
            android:id="@+id/confirmationCounterTXT"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:gravity="center"
            android:text="counter"
            android:textColor="#ffffff" />

    </LinearLayout>


</LinearLayout>
