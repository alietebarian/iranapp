<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.ideabonyan.iranapp">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--<uses-permission android:name="android.permission.READ_SMS" />-->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- SMS_RECEIVED is sent by the phone process (a different uid), so exported="false" blocks it.
             BROADCAST_SMS is held only by the system, so other apps still can't send fake codes here. -->
        <receiver
            android:name=".Utils.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>


        <!-- for android 25+ -->
        <provider
            android:name=".Utils.GenericFileProvider"
            android:authorities="${applicationId}.com.ideabonyan.iranapp.provider"
            android:exported="false"
            android:grantUriPermissions="true"
            tools:replace="android:authorities">
            <meta-data
                android:name="androidx.core.content.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"
                tools:replace="android:resource" />
        </provider>

        <activity
            android:name=".Activity.MainActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activity.LoginActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activity.SignUpActivity"
            android:screenOrientation="portrait" />

        <service
            android:name=".service.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <activity android:name="com.ideabonyan.iranapp.Activity.IntroActivity" />

        <activity
            android:name=".Activity.ConfirmationActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activity.DashboardActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activity.UpdateUserInfoActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activity.UpdatePassword"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activity.NewAdActivity"
            android:screenOrientation="portrait" />
        <!--
             The API key for Google Maps-based APIs is defined as a string resource.
             (See the file "res/values/google_maps_api.xml").
             Note that the API key is linked to the encryption key used to sign the APK.
             You need a different API key for each encryption key, including the release key that is used to
             sign the APK for publishing.
             You can define the keys for the debug and release targets in src/debug/ and src/release/. 
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <activity
            android:name=".Activity.SplashScreenActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Activity.AdListActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activity.ShowAdActivity"
            android:screenOrientation="portrait" />
        <!-- Handles rotation itself so turning the phone doesn't restart the video. -->
        <activity
            android:name=".Activity.VideoPlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:screenOrientation="sensor"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name=".Activity.ShowNews"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activity.PishkhanHafezFalActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activity.PishkhanWebviewActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activity.PishkhanTime"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activity.AroundMeActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activity.ShowCarActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activity.Edite_Car_Add"
            android:screenOrientation="portrait" />

        <!-- Image Selector Entry -->
        <activity
            android:name="me.nereo.multi_image_selector.MultiImageSelectorActivity"
            android:configChanges="orientation|screenSize"
            android:screenOrientation="portrait" />

        <!-- Image Cropper: CropImageActivity is declared by the com.github.CanHub:Android-Image-Cropper
             library's own manifest and merges in automatically; no need to redeclare it here. -->
        <activity
            android:name=".Activity.PishkhanWeatherActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".Activity.PishkhanBookSearchActivity" />
        <activity android:name=".Activity.Show_Car_list" />
        <activity android:name=".Activity.Add_New_Car_Add" />
        <activity android:name=".Activity.Show_Home_List" />
        <activity android:name=".Activity.Show_Home_Ad_Details" />
        <activity android:name=".Activity.Add_New_Home_Add" />
        <activity android:name=".Activity.Edit_Home_Add" />
        <activity android:name=".Activity.Show_Job_list" />
        <activity android:name=".Activity.Show_Job_Ad_Details" />
        <activity android:name=".Activity.Add_New_Job" />
        <activity android:name=".Activity.Edit_Job" />
        <activity android:name=".Activity.Car_Search" />
        <activity android:name=".Activity.Home_Search" />
        <activity android:name=".Activity.Job_Search" />
        <activity android:name=".Activity.HelpActivity" />
        <activity
            android:name=".Activity.AdStatsActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".Activity.SelectLoginOrRegiser"></activity>
    </application>

</manifest>