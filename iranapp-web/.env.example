# یک کپی از این فایل با نام .env بسازید و فقط مقادیری را که لازم دارید تغییر دهید.

# مسیری که برنامه روی دامنه در آن قرار می گیرد (با اسلش ابتدا و انتها)
VITE_BASE_PATH=/web/

# آدرس API. پیش فرض: همان دامنه (/api)
# VITE_API_BASE=/api

# فقط برای npm run dev: درخواست های /api و عکس ها به این سرور فرستاده می شوند
# VITE_DEV_BACKEND=http://iranapp.biz
# VITE_DEV_BACKEND=http://127.0.0.1:8000

# اپ اندروید بدون ورود اجازه استفاده نمی دهد. برای اجازه دادن به مهمان ها false بگذارید
# VITE_REQUIRE_LOGIN=true

# کاشی های نقشه (پیش فرض OpenStreetMap)
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# اعلان های وب (اختیاری) - از کنسول Firebase پروژه iranapp-fc361 > Project settings
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=iranapp-fc361
# VITE_FIREBASE_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
