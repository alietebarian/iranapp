# ایران آپ - نسخه وب (React SPA)
# این فایل همراه خروجی build در پوشه public_html/web قرار می گیرد.
# اگر مسیر را عوض کردید (VITE_BASE_PATH)، دو خط RewriteBase و RewriteRule را هم عوض کنید.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /web/

    # فایل های واقعی (js, css, تصویر، sw.js) مستقیم سرو می شوند
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # بقیه آدرس ها (مثل /web/ad/123) صفحه اصلی برنامه را می گیرند تا React مسیر را باز کند
    RewriteRule ^ /web/index.html [L]
</IfModule>

<IfModule mod_headers.c>
    # این فایل ها باید همیشه تازه باشند تا نسخه جدید برنامه به کاربران برسد
    <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest|registerSW\.js)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    # فایل های پوشه assets نام هش دار دارند و می توانند یک سال کش شوند
    <FilesMatch "\.(js|css|png|jpg|svg|ttf|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "^(sw|push-sw|workbox-[a-z0-9]+)\.js$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>
